# ─────────────────────────────────────────────────────────────────────────────
# GEO Pipeline (Final) — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: LLM Providers ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here              # https://console.groq.com
MISTRAL_API_KEY=your_mistral_key_here        # https://console.mistral.ai  (optional, improves extraction)
OPENROUTER_API_KEY=your_openrouter_key_here  # https://openrouter.ai       (optional, Agent 2 reflection)

# ── Optional: Scraping APIs (Agent 2) ────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key_here            # https://serpapi.com         (Google Maps data)
APIFY_API_TOKEN=your_apify_token_here        # https://apify.com           (TripAdvisor, Instagram, Facebook)
IG_USERNAME=your_instagram_username          # Instagram scraping (anonymous fallback available)
IG_PASSWORD=your_instagram_password

# ── Optional: Groq base URL override (any OpenAI-compatible endpoint) ────────
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Parallelism Controls (optional, defaults shown) ──────────────────────────
MAX_CONCURRENT_LLM=5          # Max parallel Groq async calls     (lower to 2 on free/eco mode)
MAX_CONCURRENT_BRANDS=3       # Max parallel brand scrapes in Agent 2
GROQ_RPM=800                  # Lower to 20-50 if hitting 429s on free tier

# ── Agent Defaults (optional, defaults shown) ─────────────────────────────────
N_RUNS=2                      # LLM query runs per prompt
N_INTENTS=6                   # Intents generated by Agent 0
N_VARIANTS=2                  # Prompt variants per intent
LANGUAGES=en,fr,ar            # Comma-separated query languages
MAX_REFLECTION_LOOPS=2        # Self-reflection iterations
MAX_RETRIES=3                 # Max retries per node/supervisor

# ── Output paths (optional, defaults shown) ───────────────────────────────────
# OUTPUT_DIR=geo_output
# AGENT2_OUTPUT_DIR=agent2_output

# ── Model Overrides (optional — Groq tier table, Apr 2026) ───────────────────
#
# TIER 1 — FREE  (safe defaults, 1 000 RPM)
#   llama-3.1-8b-instant          250K TPM · 1K RPM · fastest
#   llama-3.3-70b-versatile       300K TPM · 1K RPM · best free quality  <- analyst default
#   openai/gpt-oss-20b            250K TPM · 1K RPM · free reasoning
#
# TIER 2 — PREVIEW  (preview/paid plan required — may return 429 on free tier)
#   qwen/qwen3-32b                300K TPM · 1K RPM · strong multilingual (fr/ar)
#   meta-llama/llama-4-scout-17b-16e-instruct  300K TPM · 1K RPM
#
# TIER 3 — PAID ONLY  (require paid Developer plan)
#   groq/compound                 200K TPM · 200 RPM · lowest RPM — avoid as default
#   openai/gpt-oss-120b           250K TPM · 1K RPM · strong reasoning
#   moonshotai/kimi-k2-instruct-0905  250K TPM · 1K RPM · $1.00/$3.00 per 1M tokens
#
# Uncomment and edit below to override any default:
# MODEL_FAST=llama-3.1-8b-instant
# MODEL_STRONG=llama-3.3-70b-versatile
# MODEL_GPTOSS=openai/gpt-oss-20b
# MODEL_EXTRACTOR=llama-3.1-8b-instant
# MODEL_QWEN=qwen/qwen3-32b                    # preview plan required
# MODEL_LLAMA4=meta-llama/llama-4-scout-17b-16e-instruct
# MODEL_COMPOUND=groq/compound                 # paid plan only — 200 RPM limit!
# MODEL_ANALYST=openai/gpt-oss-120b            # paid plan only
# MODEL_KIMI=moonshotai/kimi-k2-instruct-0905  # paid plan only
# OPENROUTER_MODELS=meta-llama/llama-3.2-3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free
